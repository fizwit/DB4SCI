# crontab for mydb backups (installed for user dbaas)
# cron has a minimal env: entrypoint.sh writes the container env to /etc/environment,
# and python3 lives in /usr/local/bin (python:3.11-slim), which is not on cron's PATH.

5 1 * * * cd /app && /usr/local/bin/python3 -m mydb.backup_util --backup-all >> /var/log/backup_all.log 2>&1
