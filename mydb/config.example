# MyDB Configuration Example
# Copy this file to config.yml and customize for your environment:
#   cp mydb/config.example mydb/config.yml
# Secrets and per-deployment values come from the environment (.env),
# see mydb_config.py.

# =============================================================================
# Organization Information
# =============================================================================
# Customize messages, email, and contact information
# Used throughout the web interface and email notifications

institutionName: Example Institute
supportOrgName: Research Computing
supportOrgEmail: support@example.org
supportPerson: Jane Admin
# Support and Backup admin are lists
supportEmail:
  - dba@example.org
backup_admin_mail:
  - dba@example.org

# List of administrator usernames (AD usernames)
# Admins have access to /admin/* routes
admins:
  - jadmin

# =============================================================================
# Branding - Logo and Favicon
# =============================================================================
# Path relative to mydb/static/ directory
# Replace with your organization's logo file

organizationLogo: images/db4sci-logo.svg
backup_purge_period: 30 # used in documentation.html

# =============================================================================
# Email Configuration
# =============================================================================
# SMTP settings for sending email notifications

MAIL_FROM: db4sci@example.edu
MAIL_TO: dba@example.edu
MAIL_SERVER: smtp.example.edu

# =============================================================================
# Active Directory / LDAP Authentication
# =============================================================================
# Configure your Active Directory server for user authentication
# The AD_auth.py module can be replaced with alternative authentication
# Each is overridden by the environment variable of the same name.

ADServer: dc.example.edu
ADDomain: example.edu
ADSearchBase: dc=example,dc=edu

# =============================================================================
# S3 Backup Prefixes
# =============================================================================

s3_prefix_prod: mydb
s3_prefix_dev: dev
s3_prefix_migrate: prod

# =============================================================================
# Application Settings
# =============================================================================

# Base port range for database allocation (automatically increments from base_port)
base_port: 32010
max_port: 32999

# Docker configuration
docker: /usr/bin/docker
base_url: unix://var/run/docker.sock

# AWS CLI path
aws: aws

# Application root directory
db4sci_path: /opt/db4sci

# Log files
backup_log: /mydb/logs/backup.log
admindb_log: /mydb/logs/admindb.log

# =============================================================================
# Metadata Fields
# =============================================================================
# Metadata fields from version 1 of MyDB
# Used when creating container labels for database services

mydb_v1_meta_data:
  - username
  - dbuser
  - image
  - description
  - department
  - manager
  - owner
  - contact
  - app_name
  - backup_freq

# =============================================================================
# Database Engine Configuration
# =============================================================================
# Configuration for each supported database type
# Versions (V) are listed in display order - first image is the default.
# "volume" is the container path the data volume is mounted on; it is per
# version because upstream images move it (Postgres 18 vs 17 and older).

dbs:
  Postgres:
    default_port: 5432
    backupdir: /var/lib/postgresql/backup
    mapped_volume: ""
    command: postgres
    service_user: postgres
    V: #  Versions
      - {version: "18.6", image: "postgres:18.6", volume: /var/lib/postgresql/}
      - {version: "17.4", image: "postgres:17.4", volume: /var/lib/postgresql/data}
      - {version: "13.2", image: "postgres:13.2", volume: /var/lib/postgresql/data}
  MariaDB:
    default_port: 3306
    command: mariadb
    service_user: root
    mapped_volume: /var/lib/mysql
    V:
      - {version: "12.0.2", image: "mariadb:12.0.2", volume: /var/lib/mysql}
